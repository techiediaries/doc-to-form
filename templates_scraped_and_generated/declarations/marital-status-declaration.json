        { "type": "text", "value": "." }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "أصرح بشرفي أنني متزوج(ة) بالسيد/ة" },
        { "type": "field", "id": "f3" },
        { "type": "text", "value": "، بموجب عقد زواج مبرم بتاريخ" },
