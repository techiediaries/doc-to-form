    { "id": "f3", "type": "text", "label": "اسم الشخص الذي يسكن معه" },
    { "id": "f4", "type": "text", "label": "رقم بطاقة التعريف للشخص الثاني" },
    { "id": "f5", "type": "text", "label": "العنوان المشترك" },
    { "id": "f6", "type": "date", "label": "تاريخ بدء السكن المشترك" },
    { "id": "f7", "type": "text", "label": "المدينة" },
    { "id": "f8", "type": "date", "label": "تاريخ التحرير" }
