    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "أنا الموقع أسفله، السيد/ة" },
        { "type": "field", "id": "f1" },
        { "type": "text", "value": "، الحامل(ة) لبطاقة التعريف الوطنية رقم" },
        { "type": "field", "id": "f2" },
        { "type": "text", "value": "." }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "أوكل بموجب هذه الوكالة الخاصة، الأستاذ(ة)" },
        { "type": "field", "id": "f3" },
        { "type": "text", "value": "، المحامي(ة) بهيئة" },
        { "type": "field", "id": "f4" },
        { "type": "text", "value": "." }
      ]
    },
    {
        "type": "paragraph",
        "content": [
          { "type": "text", "value": "لينوب عني في قضية" },
          { "type": "field", "id": "f5" },
          { "type": "text", "value": "، المرفوعة أمام" },
          { "type": "field", "id": "f6" },
          { "type": "text", "value": "، ضد" },
          { "type": "field", "id": "f7" },
          { "type": "text", "value": "." }
        ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "وللوكيل المذكور أوسع الصلاحيات للدفاع عن مصالحي، وتقديم المذكرات، وحضور الجلسات، والقيام بكل الإجراءات القانونية اللازمة." }
      ]
    },
    { "type": "break" },
