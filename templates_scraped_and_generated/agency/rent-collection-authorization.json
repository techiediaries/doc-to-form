    { "id": "f5", "type": "text", "label": "اسم المكتري (المستأجر)" },
    { "id": "f6", "type": "text", "label": "عنوان العقار" },
    { "id": "f7", "type": "number", "label": "مبلغ الكراء الشهري" },
