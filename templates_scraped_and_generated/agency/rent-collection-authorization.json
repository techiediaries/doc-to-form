  "structure": [
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "وكالة خاصة بقبض الكراء" }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "أنا الموقع أسفله، السيد/ة" },
        { "type": "field", "id": "f1" },
        { "type": "text", "value": "، بصفتي مالك(ة) العقار، أوكل بموجب هذه الوكالة السيد/ة" },
        { "type": "field", "id": "f3" },
        { "type": "text", "value": "." }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "وذلك لينوب عني في قبض واجبات الكراء من المكتري، السيد/ة" },
        { "type": "field", "id": "f5" },
        { "type": "text", "value": "، المتعلقة بالعقار الكائن بـ" },
        { "type": "field", "id": "f6" },
        { "type": "text", "value": "." }
      ]
    },
    {
        "type": "paragraph",
        "content": [
          { "type": "text", "value": "مبلغ الكراء الشهري هو" },
          { "type": "field", "id": "f7" },
          { "type": "text", "value": "درهم." }
        ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "وللوكيل الحق في توقيع وصولات الكراء وتسليمها للمكتري، واتخاذ أي إجراء ضروري لتحصيل المبلغ." }
      ]
    },
    { "type": "break" },
    {
        "type": "paragraph",
        "content": [
          { "type": "text", "value": "حرر بـ" },
          { "type": "field", "id": "f8" },
          { "type": "text", "value": "بتاريخ" },
          { "type": "field", "id": "f9" }
        ]
    },
    {
        "type": "paragraph",
        "content": [
          { "type": "text", "value": "توقيع الموكل" }
        ]
    }
  ]
}
