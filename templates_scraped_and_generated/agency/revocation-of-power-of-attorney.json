
{
  "id": "revocation-of-power-of-attorney",
  "title": "إلغاء وكالة",
  "fields": [
    { "id": "f1", "type": "text", "label": "اسم الموكل" },
    { "id": "f2", "type": "text", "label": "رقم بطاقة التعريف للموكل" },
    { "id": "f3", "type": "text", "label": "اسم الوكيل" },
    { "id": "f4", "type": "text", "label": "رقم بطاقة التعريف للوكيل" },
    { "id": "f5", "type": "date", "label": "تاريخ الوكالة الأصلية" },
    { "id": "f6", "type": "text", "label": "موضوع الوكالة الملغاة" },
    { "id": "f7", "type": "text", "label": "المدينة" },
    { "id": "f8", "type": "date", "label": "تاريخ الإلغاء" }
  ],
  "structure": [
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "تصريح بإلغاء وكالة" }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "أنا الموقع أسفله، السيد/ة" },
        { "type": "field", "id": "f1" },
        { "type": "text", "value": "، الحامل(ة) لبطاقة التعريف الوطنية رقم" },
        { "type": "field", "id": "f2" },
        { "type": "text", "value": "." }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "أصرح بموجب هذه الوثيقة أنني قد ألغيت وعزلت بشكل نهائي ولا رجعة فيه الوكيل، السيد/ة" },
        { "type": "field", "id": "f3" },
        { "type": "text", "value": "، الحامل(ة) لبطاقة التعريف الوطنية رقم" },
        { "type": "field", "id": "f4" },
        { "type": "text", "value": "." }
      ]
    },
    {
        "type": "paragraph",
        "content": [
          { "type": "text", "value": "وذلك بخصوص الوكالة الممنوحة له(ا) بتاريخ" },
          { "type": "field", "id": "f5" },
          { "type": "text", "value": "، والتي كان موضوعها" },
          { "type": "field", "id": "f6" },
          { "type": "text", "value": "." }
        ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "وابتداءً من تاريخه، لا يحق للوكيل المذكور التصرف باسمي أو نيابة عني في أي أمر يتعلق بالوكالة الملغاة، وأعتبر جميع تصرفاته بعد هذا التاريخ لاغية وباطلة." }
      ]
    },
    { "type": "break" },
    {
        "type": "paragraph",
        "content": [
          { "type": "text", "value": "حرر بـ" },
          { "type": "field", "id": "f7" },
          { "type": "text", "value": "بتاريخ" },
          { "type": "field", "id": "f8" }
        ]
    },
    {
        "type": "paragraph",
        "content": [
          { "type": "text", "value": "توقيع الموكل" }
        ]
    }
  ]
}
