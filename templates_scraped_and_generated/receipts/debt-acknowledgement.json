    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "إقرار بدين" }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "أنا الموقع أسفله، السيد/ة" },
        { "type": "field", "id": "f1" },
        { "type": "text", "value": "، الحامل(ة) لبطاقة التعريف الوطنية رقم" },
        { "type": "field", "id": "f2" },
        { "type": "text", "value": "." }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "أقر وأعترف بأنني مدين للسيد/ة" },
        { "type": "field", "id": "f3" },
        { "type": "text", "value": "، الحامل(ة) لبطاقة التعريف الوطنية رقم" },
        { "type": "field", "id": "f4" },
        { "type": "text", "value": "، بمبلغ مالي قدره" },
        { "type": "field", "id": "f5" },
        { "type": "text", "value": "درهم (" },
        { "type": "field", "id": "f6" },
        { "type": "text", "value": ")." }
      ]
    },
    {
        "type": "paragraph",
        "content": [
          { "type": "text", "value": "هذا الدين ناتج عن" },
          { "type": "field", "id": "f8" },
          { "type": "text", "value": "." }
        ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "وألتزم بسداد هذا المبلغ كاملاً في موعد أقصاه" },
        { "type": "field", "id": "f7" },
        { "type": "text", "value": "." }
      ]
    },
    {
        "type": "paragraph",
        "content": [
          { "type": "text", "value": "وهذا إقرار مني بكامل الوعي والإدراك، وموقع عليه." }
        ]
    },
    { "type": "break" },
    {
        "type": "paragraph",
        "content": [
          { "type": "text", "value": "حرر بـ" },
          { "type": "field", "id": "f9" },
