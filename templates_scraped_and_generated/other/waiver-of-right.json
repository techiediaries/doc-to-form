  "structure": [
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "تصريح بالتنازل عن حق" }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "أنا الموقع أسفله، السيد/ة" },
        { "type": "field", "id": "f1" },
        { "type": "text", "value": "، الحامل(ة) لبطاقة التعريف الوطنية رقم" },
        { "type": "field", "id": "f2" },
        { "type": "text", "value": "." }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "أقر وأعترف بأنني قد تنازلت طوعاً وبكامل إرادتي عن حقي في" },
        { "type": "field", "id": "f5" },
        { "type": "text", "value": "." }
      ]
    },
    {
        "type": "paragraph",
        "content": [
          { "type": "text", "value": "وذلك لفائدة السيد/ة" },
          { "type": "field", "id": "f3" },
          { "type": "text", "value": "، الحامل(ة) لبطاقة التعريف الوطنية رقم" },
          { "type": "field", "id": "f4" },
          { "type": "text", "value": "." }
        ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "تم هذا التنازل بعوض قدره" },
        { "type": "field", "id": "f6" },
        { "type": "text", "value": " / أو بدون عوض." }
      ]
    },
    {
        "type": "paragraph",
        "content": [
          { "type": "text", "value": "وهذا التنازل نهائي لا رجعة فيه، وأبرئ ذمة المتنازل له من أي مطالبة مستقبلية بخصوص هذا الحق." }
        ]
    },
    { "type": "break" },
    {
        "type": "paragraph",
        "content": [
          { "type": "text", "value": "حرر بـ" },
