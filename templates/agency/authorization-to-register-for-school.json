    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "وكالة خاصة للتسجيل الدراسي" }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "أنا الموقع أسفله، السيد/ة" },
        { "type": "field", "id": "f1" },
        { "type": "text", "value": "، بصفتي ولي أمر الطالب(ة)" },
        { "type": "field", "id": "f3" },
        { "type": "text", "value": "." }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "أوكل بموجب هذه الوكالة، السيد/ة" },
        { "type": "field", "id": "f2" },
        { "type": "text", "value": "، لينوب عني في إتمام إجراءات تسجيل ابني/ابنتي المذكور(ة) أعلاه." }
      ]
    },
    {
        "type": "paragraph",
        "content": [
          { "type": "text", "value": "وذلك في مؤسسة" },
          { "type": "field", "id": "f4" },
          { "type": "text", "value": "، بالمستوى الدراسي:" },
          { "type": "field", "id": "f5" },
          { "type": "text", "value": "." }
        ]
    },
    {
      "type": "paragraph",
      "content": [
        { "type": "text", "value": "وللوكيل الحق في تقديم وتوقيع جميع المستندات اللازمة لذلك." }
      ]
    },
    { "type": "break" },
    {
        "type": "paragraph",
        "content": [
          { "type": "text", "value": "حرر بـ" },
          { "type": "field", "id": "f6" },
          { "type": "text", "value": "بتاريخ" },
          { "type": "field", "id": "f7" }
        ]
    },
    {
        "type": "paragraph",
        "content": [
          { "type": "text", "value": "توقيع الموكل" }
        ]
    }
  ]
