        {
          "type": "field",
          "id": "f2"
        },
        {
          "type": "text",
          "value": "بتنازلى عن حقى فى التمسك بالوعد بالبيع المبرم بتاريخ"
        },
        {
          "type": "field",
          "id": "f1"
        },
        {
          "type": "text",
          "value": "فيما بينى وبين السيد /"
