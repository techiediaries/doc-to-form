      "content": [
        {
          "type": "text",
          "value": "اقرار بقبض المقاول اجره وتخالص"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "أقر أنا"
        },
        {
          "type": "field",
          "id": "f2"
        },
        {
          "type": "text",
          "value": "\"المقاول\"  بأنه قد تمت تصفية حساب المقاولة المبرمة فيما بينى وبين السيد /"
        },
        {
          "type": "field",
          "id": "f3"
        },
        {
          "type": "text",
          "value": "\" رب العمل \" بموجب العقد المؤرخ"
        },
        {
          "type": "field",
          "id": "f1"
        },
        {
          "type": "text",
          "value": "وقد تبين ان المبلغ المتبقى لى بعد انجاز جميع الاعمال المتعاقد عليها يبلغ"
        },
        {
          "type": "field",
          "id": "f4"
        },
        {
          "type": "text",
          "value": "فقط"
        },
        {
          "type": "field",
          "id": "f5"
        },
        {
          "type": "text",
          "value": "جنيه ، وقد قام رب العمل السيد/"
        },
        {
          "type": "field",
          "id": "f6"
        },
        {
          "type": "text",
          "value": "بدفع هذا المبلغ كاملا لى نقدا وقت تحرير هذا الاقرار ، وبذلك يكون الوفاء باجر المقاولة قد تم وفقا للعقار المشار اليه ، ويعتبر هذا مخالصة بذلك وليس لى الرجوع بعد ذلك بشئ عليه"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "وهذا اقرار منى بذلك ،"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "تحريرا فى"
        },
        {
          "type": "field",
          "id": "f7"
        },
        {
          "type": "field",
          "id": "f8"
        }
      ]
    },
