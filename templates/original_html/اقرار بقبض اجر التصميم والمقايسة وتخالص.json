          "value": "اقرار بقبض اجر التصميم والمقايسة وتخالص"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "أقر أنا"
        },
        {
          "type": "field",
          "id": "f1"
        },
        {
          "type": "text",
          "value": "\" المهندس المعمارى \" بأننى قبضت مبلغ"
        },
        {
          "type": "field",
          "id": "f2"
        },
        {
          "type": "text",
          "value": "فقط"
        },
        {
          "type": "field",
          "id": "f3"
        },
        {
          "type": "text",
          "value": "جنيه من السيد/"
        },
        {
          "type": "field",
          "id": "f4"
        },
        {
          "type": "text",
          "value": "\" رب العمل\" كمقدم من أجرى المقدر بمبلغ"
        },
        {
          "type": "field",
          "id": "f5"
        },
        {
          "type": "text",
          "value": "فقط"
        },
        {
          "type": "field",
          "id": "f6"
        },
        {
          "type": "text",
          "value": "جنيه بموجب العقد المبرم فيما بيننا بتاريخ    /   /   والخاص بوضع تصميم وعمل مقايسة للبناء المنوه عنه به ، ويعتبر هذا مخالصة بهذا المبلغ وأظل خاضعا فى شأنه لاحكام العقد المشار اليه"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "وهذا اقرار منى بذلك ،"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "تحريرا فى"
        },
