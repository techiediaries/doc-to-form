          "type": "text",
          "value": "أقر أنا"
        },
        {
          "type": "field",
          "id": "f3"
        },
        {
          "type": "text",
          "value": "\" الوكيل\" بأننى لا أرغب فى الاستمرار فى أعمال الوكالة التى أناطها بى السيد /"
        },
        {
          "type": "field",
          "id": "f4"
        },
        {
          "type": "text",
          "value": "\" الموكل\" بموجب عقد الوكالة الموثق بمكتب"
        },
        {
          "type": "field",
          "id": "f5"
        },
        {
          "type": "text",
          "value": "تحت رقم"
        },
        {
