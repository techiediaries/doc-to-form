          "type": "field",
          "id": "f2"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "وهذا اقرار منى بذلك ،"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "تحريرا فى"
        },
