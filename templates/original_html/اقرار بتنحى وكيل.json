          "id": "f6"
        },
        {
          "type": "text",
          "value": "بتاريخ"
        },
        {
          "type": "field",
          "id": "f1"
        },
        {
          "type": "text",
          "value": "وقد أخطرته بذلك اليوم على أن ينفذ التنحى اعتبارا من"
        },
