      "content": [
        {
          "type": "text",
          "value": "توكيل خاص"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "أنا الموقع أدناه السيد/ة:"
        },
        {
          "type": "field",
          "id": "f1"
        },
        {
          "type": "text",
          "value": "، ب.ت.و رقم:"
        },
        {
          "type": "field",
          "id": "f2"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "المقيم/ة بـ:"
        },
        {
          "type": "field",
          "id": "f3"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "بموجب هذه الوثيقة أُوَكِّل السيد/ة:"
        },
        {
          "type": "field",
          "id": "f4"
        },
        {
          "type": "text",
          "value": "، ب.ت.و رقم:"
        },
        {
          "type": "field",
          "id": "f5"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "المقيم/ة بـ:"
        },
        {
          "type": "field",
          "id": "f6"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "للقيام نيابةً عني بما يلي:"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f7"
        }
      ]
