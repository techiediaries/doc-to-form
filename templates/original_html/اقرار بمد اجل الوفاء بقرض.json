      "content": [
        {
          "type": "text",
          "value": "اقرار بمد اجل الوفاء بقرض"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "أقر أنا"
        },
        {
          "type": "field",
          "id": "f4"
        },
        {
          "type": "text",
          "value": "\" الدائن المقرض\" باننى قابل لمد اجل الوفاء المحدد بالعقد المبرم فيما بينى وبين السيد /"
        },
        {
          "type": "field",
          "id": "f5"
        },
        {
          "type": "text",
          "value": "\" المدين المقترض\" بتاريخ"
        },
        {
          "type": "field",
          "id": "f1"
        },
        {
          "type": "text",
          "value": "والمتضمن التزام الاخير بالوفاء لى بمبلغ القرض وقدره"
        },
        {
          "type": "field",
          "id": "f6"
        },
        {
          "type": "text",
          "value": "فقط"
        },
        {
          "type": "field",
          "id": "f7"
        },
        {
          "type": "text",
          "value": "جنيه فى يوم"
        },
        {
          "type": "field",
          "id": "f2"
        },
        {
          "type": "text",
          "value": "يجعل تاريخ الوفاء يوم"
        },
        {
          "type": "field",
          "id": "f3"
        },
        {
          "type": "text",
          "value": "ويعتبر هذا التاريخ آخر مهلة للوفاء ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "وهذا اقرار منى بذلك ،"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "تحريرا فى"
        },
        {
          "type": "field",
          "id": "f8"
        },
