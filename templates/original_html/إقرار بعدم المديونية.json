  "structure": [
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "إقرار بعدم المديونية"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "أنا الموقع أدناه السيد/ة:"
        },
        {
          "type": "field",
          "id": "f1"
        },
        {
          "type": "text",
          "value": "، الحامل/ة لبطاقة التعريف الوطنية رقم:"
        },
        {
          "type": "field",
          "id": "f2"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "المقيم/ة بـ:"
        },
        {
          "type": "field",
          "id": "f3"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "أُقِرُّ بموجب هذه الوثيقة، وعن كامل إرادتي، بأنني لا أمتلك أي ديون مستحقة الأداء أو"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "التزامات مالية تجاه السيد/ة:"
        },
        {
          "type": "field",
          "id": "f4"
        },
        {
          "type": "text",
          "value": "، الحامل/ة لبطاقة التعريف الوطنية رقم:"
        },
        {
          "type": "field",
          "id": "f5"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "وذلك اعتباراً من تاريخ تحرير هذا الإقرار، وأن جميع الحسابات قد صُفِّيت بيننا بشكل كامل"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "ونهائي دون أي تحفظ أو قيد."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "وهذا إقراري أُمضيه طوعاً وتصريحاً بالحق، وليُعمَل به فيما يُستوجب."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "حُرِّر بـ"
        },
        {
          "type": "field",
          "id": "f6"
        },
        {
          "type": "text",
          "value": "بتاريخ"
        },
        {
          "type": "field",
          "id": "f7"
        },
        {
          "type": "text",
          "value": "/"
        },
        {
          "type": "field",
          "id": "f8"
        },
        {
          "type": "text",
          "value": "/"
        },
        {
