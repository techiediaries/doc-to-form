  "structure": [
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "وصل استلام مبلغ مالي"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "أنا الموقع أدناه السيد/ة:"
        },
        {
          "type": "field",
          "id": "f1"
        },
        {
          "type": "text",
          "value": "، ب.ت.و رقم:"
        },
        {
          "type": "field",
          "id": "f2"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "أُقِرُّ باستلامي من السيد/ة:"
        },
        {
          "type": "field",
          "id": "f3"
        },
        {
          "type": "text",
          "value": "، ب.ت.و رقم:"
        },
        {
          "type": "field",
          "id": "f4"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "مبلغاً مالياً قدره:"
        },
        {
          "type": "field",
          "id": "f5"
        },
        {
          "type": "text",
          "value": "درهماً مغربياً ("
        },
        {
          "type": "field",
          "id": "f6"
        },
        {
          "type": "text",
          "value": ")"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "وذلك بصفته:"
        },
        {
          "type": "field",
          "id": "f7"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "وأُقِرُّ بأن هذا المبلغ قد استُلم كاملاً دون أي نقص، وبراءة ذمة الدافع من هذا المبلغ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "حُرِّر بـ"
        },
        {
          "type": "field",
          "id": "f8"
        },
        {
          "type": "text",
          "value": "بتاريخ"
        },
        {
          "type": "field",
          "id": "f9"
        },
        {
          "type": "text",
          "value": "/"
        },
        {
