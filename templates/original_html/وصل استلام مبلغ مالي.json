        },
        {
          "type": "text",
          "value": "/"
        },
        {
          "type": "field",
          "id": "f11"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "توقيع المُقِر:"
        },
        {
          "type": "field",
          "id": "f12"
        },
        {
          "type": "text",
          "value": "توقيع الشاهد:"
        },
