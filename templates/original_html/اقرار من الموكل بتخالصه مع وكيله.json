  "structure": [
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "اقرار من الموكل بتخالصه مع وكيله"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "أقر انا"
        },
        {
          "type": "field",
          "id": "f1"
        },
        {
          "type": "text",
          "value": "\" الموكل\" بأننى قد قمت بفحص كشوف الحساب المفصلة المقدمة لى من السيد /"
        },
        {
          "type": "field",
          "id": "f2"
        },
        {
          "type": "text",
          "value": "\" الوكيل\" متضمنه مفردات الايرادات والمصروفات طوال فترة الوكالة ، وتبين لى مطابقتها للواقع الثابت بالمستندات المرفقة بالكشوف سالفة الذكر ولا توجد ثمت ملاحظات تتعلق بها ، وأن المبلغ المستحق فى ذمة السيد /"
        },
        {
          "type": "field",
          "id": "f3"
        },
        {
          "type": "text",
          "value": "\" الوكيل\" لى بسبب أعمال الوكالة قدره"
        },
        {
          "type": "field",
          "id": "f4"
        },
        {
          "type": "text",
          "value": "فقط"
        },
        {
          "type": "field",
          "id": "f5"
        },
        {
          "type": "text",
          "value": "جنيه بعد تصفية الحساب وقد قام بدفعه لى كاملا وقت تحرير هذا الاقرار ، وبذلك فقد تم التخالص عن تلك الاعمال حتى اليوم ، وتعتبر هذه مخالصة بما تقدم ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "وهذا اقرار منى بذلك ،"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "تحريرا فى"
        },
        {
          "type": "field",
          "id": "f6"
        },
        {
          "type": "field",
          "id": "f7"
        }
      ]
    },
    {
      "type": "break"
    }
  ]
}