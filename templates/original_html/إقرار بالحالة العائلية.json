  "structure": [
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "إقرار بالحالة العائلية — أعزب/عزباء"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "أنا الموقع أدناه السيد/ة:"
        },
        {
          "type": "field",
          "id": "f1"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "الحامل/ة لبطاقة التعريف الوطنية رقم:"
        },
        {
          "type": "field",
          "id": "f2"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "المزداد/ة بتاريخ:"
        },
        {
          "type": "field",
          "id": "f3"
        },
        {
          "type": "text",
          "value": "بمدينة:"
        },
        {
          "type": "field",
          "id": "f4"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "المقيم/ة بـ:"
        },
        {
          "type": "field",
          "id": "f5"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "أُقِرُّ بموجب هذه الوثيقة بأنني غير متزوج/ة حتى تاريخ تحرير هذا الإقرار، وأن"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "حالتي العائلية هي: أعزب/عزباء."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "وهذا الإقرار صادر منى طوعاً لاستخدامه لدى:"
        },
        {
          "type": "field",
          "id": "f6"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "وأتحمل المسؤولية القانونية الكاملة عن أي بيان مخالف للحقيقة."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "حُرِّر بـ"
        },
        {
          "type": "field",
          "id": "f7"
        },
        {
          "type": "text",
          "value": "بتاريخ"
        },
        {
          "type": "field",
          "id": "f8"
        },
        {
          "type": "text",
          "value": "/"
        },
        {
