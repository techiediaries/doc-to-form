      "content": [
        {
          "type": "text",
          "value": "اقرار بعلم البائع بدعوى الاستحقاق"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "أقر أنا"
        },
        {
          "type": "field",
          "id": "f3"
        },
        {
          "type": "text",
          "value": "بأن السيد/"
        },
        {
          "type": "field",
          "id": "f4"
        },
        {
          "type": "text",
          "value": "\"المشترى\" قد أخطرنى بتاريخ اليوم برفع دعوى من السيد/"
        },
        {
          "type": "field",
          "id": "f5"
        },
        {
          "type": "text",
          "value": "باستحقاق الاخير للعقار المبيع وقد تحدد لها جلسة"
        },
        {
          "type": "field",
          "id": "f1"
        },
        {
          "type": "text",
          "value": "وفقا لما تضمنه الاعلان المسلم للمشترى سالف الذكر ، ويكون له كافة الحقوق التى يرتبها القانون على اخطارى بدعوى الاستحقاق وكذلك التزامى بالضمان حسبما ينص عليه عقد البيع المبرم فيما بينى وبينه بتاريخ"
        },
        {
          "type": "field",
          "id": "f2"
        },
        {
          "type": "text",
          "value": "متعلقا بالعقار المبيع رقم"
        },
        {
          "type": "field",
          "id": "f6"
        },
        {
          "type": "text",
          "value": "الكائن"
        },
        {
          "type": "field",
          "id": "f7"
        },
        {
          "type": "text",
          "value": "."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "وهذا اقرار منى بذلك ،"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "تحريرا فى"
        },
