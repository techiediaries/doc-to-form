  "structure": [
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "بيع صيدلية"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "المادة 30 من القانون 127 لسنة 1955 المعدل"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "انه فى يوم .... الموافق    /   /"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "تم تحرير هذا العقد بين كل من :"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "1-السيد/....صيدلى، مصرى مقيم برقم .... شارع ... قسم .. محافظة ...بطاقة عائلية"
        },
        {
          "type": "field",
          "id": "f2"
        },
        {
          "type": "field",
          "id": "f1"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "2- السيد/....صيدلى، مصرى مقيم برقم .... شارع ... قسم .. محافظة ...بطاقة عائلية"
        },
        {
          "type": "field",
          "id": "f4"
        },
        {
          "type": "field",
          "id": "f3"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "يقر الطرفان بأهليتهما للتعاقد والاتفاق على ما يلى :"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f6"
        },
        {
          "type": "text",
          "value": "باع الطرف الأول للطرف الثاني الصيدلية الكائنة بشارع .... قسم ... محافظة ... وهى عبارة عن ... والصادر عنها الترخيص رقم"
        },
        {
          "type": "field",
          "id": "f7"
        },
        {
          "type": "text",
          "value": "بتاريخ"
        },
        {
          "type": "field",
          "id": "f5"
        },
        {
          "type": "text",
          "value": "باسم الطرف الأول ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f8"
        },
        {
          "type": "text",
          "value": "يشمل البيع المكان المجر المبين بالبند السابق ، وأجهزة المعمل وهى عبارة عن"
        },
        {
          "type": "field",
          "id": "f9"
        },
        {
          "type": "text",
          "value": "وجميع موجودات الصيدلية المادية من أرفف ومناضد ومواد وتجهيزات وأدوية وكذلك الاسم التجاري المعروفة به وهو \" .... \" والسمعة والاتصال بالعملاء والحق في الإيجار ، ويتعهد الطرف الأول بالتنازل عن عقد الإيجار للطرف الثاني فور التوقيع على هذا العقد ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f11"
        },
        {
          "type": "text",
          "value": "يقر الطرف الأول بأن رخصة الصيدلية سارية المفعل وان العين مؤجرة له من السيد /"
        },
        {
          "type": "field",
          "id": "f12"
        },
        {
          "type": "text",
          "value": "بموجب عقد إيجار مؤرخ"
        },
        {
          "type": "field",
          "id": "f10"
        },
        {
          "type": "text",
          "value": "ولم ترفع فى شأنه دعاوى فسخ ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f13"
        },
        {
          "type": "text",
          "value": "يلتزم الطرف الأول بتسليم المبيع للطرف الثاني والتنازل له عن الرخصة واتخاذ كل ما يلزم لنقلها باسمه فور التوقيع على هذا العقد ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f14"
        },
        {
          "type": "text",
          "value": "قام الطرف الثاني بمعاينة المبيع المعاينة التامة النافية للجهالة وليس له الرجوع على الطرف الأول بما قد يظهر من عيوب ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f15"
        },
        {
          "type": "text",
          "value": "يقر الطرف الأول بأنه لم يكن يمتلك صيدلية أخرى وقت تملكه للصيدلية المبيعة وانه لم يكن موظفا حكوميا وقت تملكه لها ، كما يقر الطرف الثاني بأنه ليس موظفا حكوميا ولم يمتلك صيدلية أخرى وقت إبرام هذا العقد وإلا فلا رجوع له على الطرف الأول باى شئ فى حالة إبطال العقد ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f16"
        },
        {
          "type": "text",
          "value": "تم هذا البيع لقاء ثمن اجمالى وجزافي قدره ... فقط ... دفعه الطرف الثاني للطرف الأول بمجلس هذا العقد ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f17"
        },
        {
          "type": "text",
          "value": "لا يجوز لأي من الطرفين الرجوع في هذا العقد لاى سبب من الأسباب ويقر الطرف الثاني بأنه اشترى ساقط الخيار بعد عمله بكافة الظروف التي أحاطت هذا البيع ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f18"
        },
        {
          "type": "text",
          "value": "يتعهد الطرف الثاني بالوفاء للمؤجر بكافة الالتزامات المترتبة على عقد الإيجار اعتبارا من الان ، ويكون وحده مسئولا عنها ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f19"
        },
        {
          "type": "text",
          "value": "تختص محاكم .... بنظر المنازعات التي قد تنشأ عن هذا العقد ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f20"
        },
        {
          "type": "text",
          "value": "يعتبر عنوان كل من المتعاقدين المبين بهذا العقد موطنا مختارا بالنسبة لما تتطلبه إجراءات تنفيذه الى ان يتم الإخطار بتغييره كتابة ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f21"
        },
        {
          "type": "text",
          "value": "حرر هذا العقد من نسختين ، لكل طرف نسخة ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f22"
        },
        {
          "type": "field",
          "id": "f23"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f24"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "يكتب محضر التصديق ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "ملاحظة : يخضع بيع الصيدلية لأحكام الجدك وفقا للمادة 594/2 من القانون المدني ويضيف القانون رقم 127 لسنة 1955شرطا إضافيا فيتطلب ان يكون المشترى صيدليا وليس موظفا عموميا أو لا يمتلك صيدلية أخرى وقت تحرير العقد وإلا كان البيع باطلا بطلانا مطلاقا ."
        }
      ]
    },
    {
      "type": "break"
    }
  ]
}