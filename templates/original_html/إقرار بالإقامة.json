        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "الحامل/ة لبطاقة التعريف الوطنية رقم:"
        },
        {
          "type": "field",
          "id": "f2"
        },
        {
          "type": "text",
          "value": "الصادرة بتاريخ:"
