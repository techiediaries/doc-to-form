  "structure": [
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "اقرار بوعد بفسخ عقد ايجار"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "أقر أنا"
        },
        {
          "type": "field",
          "id": "f2"
        },
        {
          "type": "text",
          "value": "\" المستأجر \" بقبول فسخ عقد الايجار المبرم فيما بينى وبين المؤجر السيد/"
        },
        {
          "type": "field",
          "id": "f3"
        },
        {
          "type": "text",
          "value": "إذا رد لى مبلغ وقدره"
        },
        {
          "type": "field",
          "id": "f4"
        },
        {
          "type": "text",
          "value": "فقط"
        },
        {
          "type": "field",
          "id": "f5"
        },
        {
          "type": "text",
          "value": "جنيه الذى انفقته على الانشاءات التى اقمتها بالعين المؤجرة والمتمثلة فى"
        },
        {
          "type": "field",
          "id": "f6"
        },
        {
          "type": "text",
          "value": "\" أو إذا رد لى المبلغ الذى عجلته له وقدره"
        },
        {
          "type": "field",
          "id": "f7"
        },
        {
          "type": "text",
          "value": "فقط"
        },
        {
          "type": "field",
          "id": "f8"
        },
        {
          "type": "text",
          "value": "جنيه ( يراعى ان المقدم غير محدد بالنسبة للاماكن الخاضعة لاحكام القانون المدنى كما فى ايجار المنقول ويأخذ حكمه المحل التجارى والعين المفروشة والارض الفضاء وقضت محكمة النقض أن دفع مبلغ خارج نطاق العقد الخاضع لاحكام القانون المدنى غير مؤثم – على أن يتم ذلك خلال اجل غايته يوم"
        },
        {
          "type": "field",
          "id": "f1"
        },
        {
          "type": "text",
          "value": "بحيث غذا انقضى هذا الاجل دون رد المبلغ سالف البيان يعتبر هذا الوعد كأن لم يكن ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "وهذا اقرار منى بذلك ،"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "تحريرا فى"
        },
        {
          "type": "field",
          "id": "f9"
        },
        {
          "type": "field",
          "id": "f10"
        }
      ]
    },
    {
      "type": "break"
    }
  ]
}