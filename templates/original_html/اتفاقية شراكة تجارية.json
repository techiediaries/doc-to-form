    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "الشريك الأول: السيد/ة"
        },
        {
          "type": "field",
          "id": "f1"
        },
        {
          "type": "text",
          "value": "، ب.ت.و رقم:"
        },
        {
          "type": "field",
          "id": "f2"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "الشريك الثاني: السيد/ة"
        },
        {
          "type": "field",
          "id": "f3"
        },
        {
          "type": "text",
          "value": "، ب.ت.و رقم:"
        },
        {
          "type": "field",
          "id": "f4"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "اتُّفق الطرفان على إنشاء شراكة تجارية وفق الشروط التالية:"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "المادة 1 — موضوع الشراكة:"
        },
        {
          "type": "field",
          "id": "f5"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "المادة 2 — مقر النشاط:"
        },
        {
          "type": "field",
          "id": "f6"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "المادة 3 — رأس المال: يُقدَّر رأس مال الشراكة بمبلغ:"
        },
        {
          "type": "field",
          "id": "f7"
        },
        {
          "type": "text",
          "value": "درهماً"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "يساهم الشريك الأول بـ:"
        },
        {
          "type": "field",
          "id": "f8"
        },
        {
          "type": "text",
          "value": "درهماً ("
        },
        {
          "type": "field",
          "id": "f9"
        },
        {
          "type": "text",
          "value": "%)"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "يساهم الشريك الثاني بـ:"
        },
        {
          "type": "field",
          "id": "f10"
        },
        {
          "type": "text",
          "value": "درهماً ("
        },
        {
          "type": "field",
          "id": "f11"
        },
        {
          "type": "text",
          "value": "%)"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "المادة 4 — توزيع الأرباح والخسائر: تُوزَّع الأرباح والخسائر بالتساوي ما لم يُتفق غير ذلك."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "المادة 5 — مدة الشراكة: تبدأ من:"
        },
        {
          "type": "field",
          "id": "f12"
        },
        {
          "type": "text",
          "value": "وتمتد لمدة:"
        },
        {
          "type": "field",
          "id": "f13"
        },
        {
          "type": "text",
          "value": "قابلة للتجديد."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "توقيع الشريك الأول:                                    توقيع الشريك الثاني:"
