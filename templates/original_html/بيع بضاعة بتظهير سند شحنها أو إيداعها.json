  "structure": [
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "بيع بضاعة بتظهير سند شحنها أو إيداعها"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "القانون البحري والمادة 952 وما بعدها من القانون المدني ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "أنه في يوم \t\tالموافق"
        },
        {
          "type": "field",
          "id": "f1"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "تم تحرير هذا العقد بين كل من :"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "1- السيد/ \t\t\t\tمصري الجنسية مقيم برقم"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "قسم \t\tمحافظة"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "يحمل بطاقة عائلية رقم"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "سجل مدني"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f2"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "2- السيد/ \t\t\t\tمصري الجنسية مقيم برقم"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "قسم \t\tمحافظة"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "يحمل بطاقة عائلية رقم"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "سجل مدنى"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f3"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "يقر الطرفان بأهليتهما للتعاقد واتفاقهما على ما يلي :"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f5"
        },
        {
          "type": "text",
          "value": "باع الطرف الأول للطرف الثاني البضاعة المبينة بسند الشحن رقم ... بتاريخ"
        },
        {
          "type": "field",
          "id": "f4"
        },
        {
          "type": "text",
          "value": "الصادر من ....لأمر الطرف الأول ، وهى عبارة عن"
        },
        {
          "type": "field",
          "id": "f6"
        },
        {
          "type": "text",
          "value": "\"أو الصادر من .... لحامله ، وهى عبارة عن"
        },
        {
          "type": "field",
          "id": "f7"
        },
        {
          "type": "text",
          "value": "\""
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f9"
        },
        {
          "type": "text",
          "value": "يقر الطرف الأول انه قام بشجن البضاعة المبينة بالبند السابق بحالة سليمة وجيدة وخلو سند الشحن من ملاحظات تتعارض مع ذلك ، على السفينة ... التابعة لشركة ... المقرر وصولها إلى ميناء ... في"
        },
        {
          "type": "field",
          "id": "f8"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f10"
        },
        {
          "type": "text",
          "value": "يقر الطرف الأول بالتزامه بتظهير سند الشحن فور التوقيع على هذا العقد \" متى كان السند لأمر الطرف الأول\" أو بتسليمه للطرف الثاني فور التوقيع على هذا العقد \" متى كان السند لحامله ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f11"
        },
        {
          "type": "text",
          "value": "يقر الطرف الأول بأنه لم يسبق له تظهير أية صورة من سند الشحن الخاص بالبضاعة المبيعة وان التظهير للطرف الثاني هو التظهير الأول كما يضمن الأخير التعرضات القانونية التي تصدر من الغير أيا كان سببها وكذلك العيوب التي تشوب المبيع ما لم تكن بسبب الشحن ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f12"
        },
        {
          "type": "text",
          "value": "من المتفق عليه أن تبعة هلاك المبيع ، تكون على عاتق الطرف الأول إذا كان الهلاك سابقا على تظهير"
        },
        {
          "type": "field",
          "id": "f13"
        },
        {
          "type": "text",
          "value": "سند الشحن  ، وعلى عاتق الطرف الثاني إذا كان بعد ذلك ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f14"
        },
        {
          "type": "text",
          "value": "يلتزم الطرف الأول بتسليم الطرف الثاني توابع المبيع وعلى الأخص بوالص التأمين ، ويصبح الطرف الثاني وحده صاحب الحق فى مبلغ التأمين في حالة هلاك البضاعة بعد تظهير"
        },
        {
          "type": "field",
          "id": "f15"
        },
        {
          "type": "text",
          "value": "سند الشحن) ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f16"
        },
        {
          "type": "text",
          "value": "تم هذا البيع لقاء ثمن قدره ...فقط .... منه الطرف الثاني بمجلس هذا العقد مبلغ ... فقط ... والباقي عند وصول البضاعة أو ثبوت هلاكها بعد تظهير"
        },
        {
          "type": "field",
          "id": "f17"
        },
        {
          "type": "text",
          "value": "سندا لشحن ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f18"
        },
        {
          "type": "text",
          "value": "يعتبر العقد مفسوخا من تلقاء نفسه دون حاجة لتنبيه أو اى إجراء أخر في حالة إخلال الطرف الثاني بالتزامه بالوفاء بباقي الثمن على النحو المبين بالبند السابق ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f19"
        },
        {
          "type": "text",
          "value": "العنوان الموضح قرين اسم كل طرف، هو الموطن المختار له فيما يتعلق بالإجراءات التي يتطلبها تنفيذ هذا العقد ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f20"
        },
        {
          "type": "text",
          "value": "حرر هذا العقد من نسختين ، لكل طرف نسخة ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "field",
          "id": "f21"
        },
        {
          "type": "field",
          "id": "f22"
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "ملاحظة : يسرى هذا النموذج بالنسبة للمنقولات المودعة بمخازن البائع أو الناقل على التفصيل الذي أوضحناه بالمادة 952 مدني وما بعدها ."
        }
      ]
    },
    {
      "type": "paragraph",
      "content": [
        {
          "type": "text",
          "value": "وإذا أضاف المتعاقدان شرطا مكتوبا إلى العقد المطبوع ، وجب أعمال هذا الشرط ولو تعارض مع شرط مطبوع \" نقض 31/1/1983 طعن 832 س 48 ق\""
        }
      ]
    },
    {
      "type": "break"
    }
  ]
}